\ProvidesPackage{carloscv_style}

% --- Paquetes necesarios ---
\RequirePackage{fontspec} 
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{fontawesome5}
\RequirePackage{hyperref}

% --- Definición de Colores ---
\definecolor{bulletgray}{HTML}{7F8081}
\definecolor{cvteal}{HTML}{6FCCDD} % turquesa

% --- Definición de Fuentes ---
\newfontfamily\listfont[
    Path=fonts/,
    AutoFakeSlant=0.2,
    AutoFakeBold=1.5
]{TitilliumMaps26L003.otf}

% --- Configuración de Hipervínculos ---
\hypersetup{
    colorlinks=true,
    linkcolor=cvteal,
    urlcolor=cvteal,
    pdftitle={CV Carlos Briceño},
    pdfauthor={Carlos Briceño},
    pdfsubject={Electronic Engineer CV},
}

% --- Definición de Iconos ---
\newcommand{\iconEmail}{\textcolor{cvteal}{\faEnvelope}}
\newcommand{\iconPhone}{\textcolor{cvteal}{\faMobile*}}
\newcommand{\iconGithub}{\textcolor{cvteal}{\faGithub}}
\newcommand{\iconLinkedin}{\textcolor{cvteal}{\faLinkedin}}
\newcommand{\iconGlobe}{\textcolor{cvteal}{\faGlobe}}
\newcommand{\iconBriefcase}{{\color{black}\fontsize{9}{14}\selectfont\faBriefcase}}
\newcommand{\iconGraduation}{{\color{black}\fontsize{9}{14}\selectfont\faGraduationCap}}
\newcommand{\iconLightbulb}{{\color{black}\fontsize{9}{14}\selectfont\faLightbulb}}
\newcommand{\iconUser}{{\color{black}\fontsize{9}{14}\selectfont\faUser}}
\newcommand{\iconProfile}{{\color{black}\fontsize{9}{14}\selectfont\faIdCard}}
\newcommand{\iconSkills}{{\color{black}\fontsize{9}{14}\selectfont\faCogs}}
\newcommand{\iconInterests}{{\color{black}\fontsize{9}{14}\selectfont\faStar}}
\newcommand{\iconLanguage}{{\color{black}\fontsize{11}{14}\selectfont\faLanguage}}

% --- Configuración de Listas (Itemize) viñetas---
\setlist[itemize]{
    leftmargin=1.5em,
    noitemsep, 
    topsep=2pt, 
    parsep=2pt,
    label={\tikz[baseline=-0.6ex]{\fill[black] (0,0) circle (1.5pt);}}, 
    before={\listfont\fontsize{9}{12}\selectfont} 
}

% --- Ajustes de Tablas ---
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.2}